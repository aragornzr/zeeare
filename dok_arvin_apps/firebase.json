{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "dashboard-users",
      "ignore": [
        "node_modules",
        ".git",
        "*-debug.log",
        "*.test.js"
      ]
    }
  ],
  "hosting": {
    "public": "zeeare",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
